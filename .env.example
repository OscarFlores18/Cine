# =====================================================================
# Copiar este archivo a ".env" (mismo directorio que docker-compose.yml) y
# completar los valores reales. ".env" NUNCA se commitea (agregarlo al
# .gitignore del repo donde quede este docker-compose.yml) — tiene
# credenciales de verdad.
#
#   cp .env.example .env
#
# Sin .env, "docker compose up" igual levanta todo con los defaults de DEMO
# que estan en docker-compose.yml (sirven para probar que todo prende, pero
# Mercado Pago no va a mandar el token real y Gmail no va a mandar mails).
# =====================================================================

# --- Secretos del sistema (antes hardcodeados en el repo de properties) ---
# Generar cada uno con: openssl rand -base64 32
JWT_SECRET=
GATEWAY_INTERNAL_SECRET=

# --- RabbitMQ ---
# Opcional: si no se completa, se usa guest/guest (lo que ya usan hoy todos
# los *-docker.yml del repo de properties).
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- Mercado Pago (sandbox) ---
# Access token de PRUEBA de tu app en Mercado Pago Developers (asociado al
# usuario de prueba vendedor). Panel: https://www.mercadopago.com.ar/developers
MERCADOPAGO_ACCESS_TOKEN=

# Solo hace falta tocar esto si usás el servicio ngrok del compose
# (--profile ngrok) con URL aleatoria: pegar ahi la URL que te da ngrok
# (ver http://localhost:4040) + "/ventas/webhook/mercadopago". Si usás un
# dominio estatico de ngrok, dejalo vacio (el valor ya viene bien armado).
MERCADOPAGO_NOTIFICATION_URL=

# --- Gmail (remitente de los mails de confirmacion/cancelacion) ---
# GMAIL_USERNAME: la cuenta de Gmail completa (tunombre@gmail.com).
# GMAIL_APP_PASSWORD: una "contraseña de aplicación" generada en esa cuenta
# (Cuenta de Google -> Seguridad -> Verificacion en 2 pasos (activarla
# primero si no esta) -> Contraseñas de aplicaciones). NO es la contraseña
# normal de la cuenta -esa no funciona para SMTP y Google la rechaza.
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# --- ngrok (opcional, solo si levantás el perfil "ngrok") ---
# Cuenta gratuita en https://ngrok.com -> tu authtoken esta en el dashboard.
NGROK_AUTHTOKEN=
# Dominio estatico gratuito (uno por cuenta) para que la URL publica no
# cambie entre reinicios. Opcional -ver nota en docker-compose.yml.
NGROK_DOMAIN=
